# --- EXAMPLE CONFIGURATION ---
# Copy this file to .env to run on example data
# Paths are relative to project root

# Base directory for example data
PARAGLIDEML_DATA_DIR=data/example

# GFS Data (empty in example, used for cache generation)
PARAGLIDEML_GFS_ANL_DIR=data/example/gfs/anl
PARAGLIDEML_GFS_CACHE_DIR=data/example/gfs/cache

# Flight logs (empty in example)
PARAGLIDEML_FLIGHTS_DIR=data/example/flights

# Preprocessed CSV datasets (contains example multicell_dataset.csv)
PARAGLIDEML_PROCESSED_DATA_DIR=data/example/processed

# Model artifacts output
PARAGLIDEML_MODELS_DIR=models
PARAGLIDEML_EXPERIMENTS_DIR=models/experiments

# --- DEFAULTS ---
PARAGLIDEML_DATES=2021-05-15:2025-09-15
PARAGLIDEML_DEFAULT_BBOX=13.0,46.0,14.0,47.0
PARAGLIDEML_MIN_XC_POINTS=10  # Minimum XContest points for quality XC flight
PARAGLIDEML_NUM_REGIONS=1
PARAGLIDEML_EPOCHS=10
PARAGLIDEML_BATCH_SIZE=32
PARAGLIDEML_LEARNING_RATE=0.001
